@model ProductSearchModel
@using Nop.Web.Framework.Models.DataTables

@{
    Layout = "_AdminPopupLayout"; // Спеціальний чистий лейаут без меню сайту
    ViewBag.PageTitle = "Додати товари до прайс-листа";
}

<form asp-controller="PriceList" asp-action="ProductAddPopup" method="post">
    <input type="hidden" name="priceListId" value="@ViewBag.PriceListId" />
    <input type="hidden" name="btnId" value="@ViewBag.BtnId" />

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "products-grid",
                                        UrlRead = new DataUrl("ProductAddPopupList", "PriceList", null),
                                        Length = Model.PageSize,
                                        LengthMenu = Model.AvailablePageSizes,
                                        ColumnCollection = new List<ColumnProperty>
                                        {
                                        // Спеціальна колонка-чекбокс від nopCommerce
                                        new ColumnProperty(nameof(ProductModel.Id))
                                        {
                                        IsMasterCheckBox = true,
                                        Render = new RenderCheckBox("checkbox_products"),
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Width = "50"
                                        },
                                        new ColumnProperty(nameof(ProductModel.Name))
                                        {
                                        Title = "Назва товару",
                                        Width = "400"
                                        },
                                        new ColumnProperty(nameof(ProductModel.Sku))
                                        {
                                        Title = "SKU",
                                        Width = "100"
                                        }
                                        }
                                        })
                </div>
                <div class="card-footer">
                    <button type="button" id="save-selected" class="btn btn-primary">
                        <i class="fas fa-save"></i> Зберегти обрані
                    </button>
                </div>
            </div>
        </div>
    </section>
</form>

<script>
    $(document).ready(function () {
        $('#save-selected').click(function () {
            // Збираємо всі відмічені чекбокси товарів
            var selectedIds = [];
            $('input[name=checkbox_products]:checked').each(function () {
                selectedIds.push($(this).val());
            });

            if (selectedIds.length === 0) {
                alert("Будь ласка, виберіть хоча б один товар.");
                return;
            }

            // Відправляємо вибрані ID на збереження в контролер
            var postData = {
                priceListId: '@ViewBag.PriceListId',
                selectedProductIds: selectedIds.join(',')
            };

            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("SelectedProductAdd", "PriceList")",
                data: postData,
                success: function (data) {
                    // Закриваємо попуп та оновлюємо батьківську таблицю
                    try { window.opener.document.getElementById('@ViewBag.BtnId').click(); }
                    catch (e) { }
                    window.close();
                }
            });
        });
    });
</script>