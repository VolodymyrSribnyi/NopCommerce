@model ProductSearchModel
@using Nop.Web.Framework.Models.DataTables

@{
    Layout = "_AdminPopupLayout"; // Спеціальний чистий лейаут без меню сайту
    ViewBag.PageTitle = "Додати товари до прайс-листа";
}

<form asp-controller="PriceList" asp-action="ProductAddPopup" method="post">
    <input type="hidden" name="priceListId" value="@ViewBag.PriceListId" />
    <input type="hidden" name="btnId" value="@ViewBag.BtnId" />

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "products-grid",
                                        UrlRead = new DataUrl("ProductAddPopupList", "PriceList", null),
                                        Length = Model.PageSize,
                                        LengthMenu = Model.AvailablePageSizes,
                                        ColumnCollection = new List<ColumnProperty>
                                        {
                                        // Спеціальна колонка-чекбокс від nopCommerce
                                        new ColumnProperty(nameof(ProductModel.Id))
                                        {
                                        IsMasterCheckBox = true,
                                        Render = new RenderCheckBox("checkbox_products"),
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Width = "50"
                                        },
                                        new ColumnProperty(nameof(ProductModel.Name))
                                        {
                                        Title = "Назва товару",
                                        Width = "400"
                                        },
                                        new ColumnProperty(nameof(ProductModel.Sku))
                                        {
                                        Title = "SKU",
                                        Width = "100"
                                        }
                                        }
                                        })
                </div>
                <div class="card-footer">
                    <button type="button" id="save-selected" class="btn btn-primary">
                        <i class="fas fa-save"></i> Зберегти обрані
                    </button>
                </div>
            </div>
        </div>
    </section>
</form>

<script asp-location="Footer">
    $(document).ready(function () {
    console.log("JS завантажено, кнопка готова!"); // Перевірка 1

    $('#save-selected').click(function (e) {
    e.preventDefault();
    console.log("Клік по кнопці спрацював!"); // Перевірка 2

    var selectedIds = [];
    $('input[name=checkbox_products]:checked').each(function () {
    selectedIds.push($(this).val());
    });

    console.log("Вибрані ID: ", selectedIds); // Перевірка 3

    if (selectedIds.length === 0) {
    alert("Будь ласка, оберіть хоча б один товар.");
    return;
    }

        var postData = {
        selectedIds: selectedIds.join(','), // 👈 Змінили ключ тут!
        priceListId: '@ViewBag.PriceListId'
    };

    // Надійно додаємо токен безпеки вручну, щоб не залежати від зовнішніх функцій
    var token = $('input[name="__RequestVerificationToken"]').val();
    if (token) {
    postData['__RequestVerificationToken'] = token;
    }

    console.log("Дані готові до відправки: ", postData); // Перевірка 4
    $.ajax({
    cache: false,
    type: "POST",
    url: "@Url.Action("SelectedProductAdd", "PriceList")",
    data: postData,
    success: function (data) {
    if (data.success) {
    try {
    // Оновлюємо батьківське вікно
    window.opener.document.getElementById('@ViewBag.BtnId').click();
    }
    catch (err) {
    console.error("Не вдалося оновити батьківське вікно:", err);
    }
    // Закриваємо попап
    window.close();
    } else {
    alert("Помилка при збереженні товарів. Контролер повернув false.");
    }
    },
    error: function (xhr, textStatus, errorThrown) {
    console.error("Помилка AJAX:", errorThrown);
    alert("Сталася помилка з'єднання: " + errorThrown);
    }
    });
    });
    });
</script>