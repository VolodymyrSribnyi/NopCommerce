@model PriceListModel
@using Nop.Web.Framework.Models.DataTables
@using Nop.Web.Areas.Admin.Models.Catalog

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Nop.Web.Framework

<div class="content-header clearfix">
    <h1 class="float-left">
        Редагування прайс-листа: @Model.Name
        <small>
            <i class="fas fa-arrow-circle-left"></i>
            <a asp-action="List">Назад до списку</a>
        </small>
    </h1>

    <div class="float-right">
        <span id="pricelist-delete" class="btn btn-danger">
            <i class="far fa-trash-can"></i>
            Видалити прайс-лист
        </span>
    </div>
</div>

<div class="card card-default">
    <div class="card-header font-weight-bold">
        <div class="card-title">
            <i class="fas fa-list"></i>
            Товари у прайс-листі (ID: @Model.Id)
        </div>

        <div class="card-tools">
            <button type="button" class="btn btn-primary"
                    onclick="javascript:OpenWindow('@Url.Action("ProductAddPopup", "PriceList", new { priceListId = Model.Id, btnId = "btnRefreshItems" })', 800, 800, true); return false;">
                <i class="fas fa-plus-square"></i>
                Додати товар
            </button>

            <button type="button" id="btnRefreshItems" style="display: none"></button>
        </div>
    </div>

    <div class="card-body">
        @Html.AntiForgeryToken()

        @await Html.PartialAsync("Table", new DataTablesModel
        {
            Name = "itemsgrid",

            UrlRead = new DataUrl("PriceListItemsList", "PriceList", null),
            UrlUpdate = new DataUrl("PriceListItemUpdate", "PriceList", null),
            UrlDelete = new DataUrl("PriceListItemDelete", "PriceList", null),

            SearchButtonId = "btnRefreshItems",
            Length = 10,

            Filters = new List<FilterParameter>
            {
                new FilterParameter(nameof(PriceListItemSearchModel.PriceListId), Model.Id)
            },

            ColumnCollection = new List<ColumnProperty>
            {
                new ColumnProperty(nameof(PriceListItemModel.ProductName))
                {
                    Title = "Товар",
                    Width = "300"
                },

                new ColumnProperty(nameof(PriceListItemModel.Price))
                {
                    Title = "Ціна",
                    Width = "150",
                    Editable = true,
                    EditType = EditType.Number
                },

                new ColumnProperty(nameof(PriceListItemModel.Id))
                {
                    Title = "Редагувати",
                    Width = "120",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonsInlineEdit()
                },

                new ColumnProperty(nameof(PriceListItemModel.Id))
                {
                    Title = "Видалити",
                    Width = "100",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonRemove("Видалити")
                }
            }
        })
    </div>
</div>

<nop-delete-confirmation asp-model-id="@Model.Id"
                         asp-button-id="pricelist-delete" />

<script>
    $(document).ready(function () {
        $('#btnRefreshItems').click(function () {
            updateTable('#itemsgrid');
            return false;
        });
    });
</script>