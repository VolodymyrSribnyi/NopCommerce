@model PriceListModel
@using Nop.Web.Framework.Models.DataTables

<div class="card card-default">
    <div class="card-header font-weight-bold">
        <div class="card-title">
            <i class="fas fa-list"></i>
            Товари у прайс-листі
        </div>
        @if (Model.Id > 0)
        {
            @* Кнопка для відкриття вікна з вибором товарів каталогу *@
            <div class="card-tools pl-2">
                <button type="submit" id="btnAddNewProduct"
                        class="btn btn-primary"
                        onclick="javascript:OpenWindow('@Url.Action("ProductAddPopup", "PriceList", new { priceListId = Model.Id, btnId = "btnRefreshItems" })', 800, 800, true); return false;">
                    <i class="fas fa-plus-square"></i>
                    Додати товар
                </button>
                @* Прихована кнопка. Попуп «клікне» по ній після закриття, щоб оновити таблицю *@
                <button type="button" id="btnRefreshItems" style="display: none"></button>
            </div>
        }
    </div>
    <div class="card-body">
        @if (Model.Id > 0)
        {
            @await Html.PartialAsync("Table", new DataTablesModel
            {
                Name = "pricelistitems-grid",
                UrlRead = new DataUrl("PriceListItemsList", "PriceList", new RouteValueDictionary { [nameof(PriceListItemSearchModel.PriceListId)] = Model.Id }),
                UrlUpdate = new DataUrl("PriceListItemUpdate", "PriceList", null),
                Length = Model.PriceListItemSearchModel.PageSize,
                LengthMenu = Model.PriceListItemSearchModel.AvailablePageSizes,
                ColumnCollection = new List<ColumnProperty>
                {
                new ColumnProperty(nameof(PriceListItemModel.ProductName))
                {
                Title = "Товар",
                Width = "300"
                },
                new ColumnProperty(nameof(PriceListItemModel.Price))
                {
                Title = "Ціна",
                Width = "150",
                Editable = true,
                EditType = EditType.Number
                },
                new ColumnProperty(nameof(PriceListItemModel.Id))
                {
                Title = "Видалити",
                Width = "100",
                ClassName = NopColumnClassDefaults.Button,
                // Використовуємо універсальний RenderCustom, який просто згенерує HTML-кнопку
                Render = new RenderCustom(@"
                function(data, type, row) {
                return '<button type=""button"" class=""btn btn-danger"" onclick=""deletePriceListItem(' + data + ')""><i class=""fas fa-trash""></i> Видалити</button>';
                }")
                }}})

        @* Скрипти для обробки оновлення та видалення *@
        <script>
            $(document).ready(function () {
                // Оновлення таблиці після закриття спливаючого вікна
                $('#btnRefreshItems').click(function () {
                    updateTable('pricelistitems-grid');
                    return false;
                });
            });

            // Функція видалення товару з прайс-листа
            function deletePriceListItem(id) {
                if (confirm("Ви впевнені, що хочете видалити цей товар з прайс-листа?")) {
                    postData('@Url.Action("PriceListItemDelete", "PriceList")', { id: id }, null, function() {
                        updateTable('pricelistitems-grid');
                    });
                }
            }
        </script>
                }
        else
        {
            <div class="alert alert-info">
                Спочатку збережіть прайс-лист, щоб мати можливість додавати до нього товари.
            </div>
        }
    </div>
</div>